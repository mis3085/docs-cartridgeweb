&lt;figure class=&#34;grid-w50 pb-4 text-center&#34;&gt;&lt;img src=&#34;https://mis3085.github.io/docs-cartridgeweb/2008_14240109973811854038.jpg&#34; alt=&#34;Markteinführung der Marke Cartridge Web im Jahr 2008&#34; class=&#34;mx-auto max-w-full h-auto&#34;/&gt;&lt;figcaption&gt;Markteinführung der Marke Cartridge Web im Jahr 2008&lt;/figcaption&gt;&lt;/figure&gt;
&lt;/div&gt;


&lt;h3 class=&#34;relative group&#34;&gt;2010 - Heute 
    &lt;div id=&#34;2010---heute&#34; class=&#34;anchor&#34;&gt;&lt;/div&gt;
    
    &lt;span
        class=&#34;absolute top-0 w-6 transition-opacity opacity-0 ltr:-left-6 rtl:-right-6 not-prose group-hover:opacity-100&#34;&gt;
        &lt;a class=&#34;group-hover:text-primary-300 dark:group-hover:text-neutral-700 !no-underline&#34; href=&#34;#2010---heute&#34; aria-label=&#34;Anker&#34;&gt;#&lt;/a&gt;
    &lt;/span&gt;        
    
&lt;/h3&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;2010&lt;/strong&gt;: Baubeginn eines Hotelgebäudes in der Region Taichung Harbor.&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;2012&lt;/strong&gt;: Erreichung der ISO 14001-Zertifizierung.&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;2013&lt;/strong&gt;: Große Eröffnung des Taichung Harbor Hotels im März.&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;2018&lt;/strong&gt;: Vollständige Übernahme von Katun Holdings LP, dem weltweit größten Distributor von Aftermarket-Imaging-Produkten. Kapital wurde durch Bareinlagen weiter erhöht.&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;2021&lt;/strong&gt;: Erreichung der ISO 13485-Zertifizierung.&lt;/li&gt;
&lt;/ul&gt;
&lt;div id=&#34;gallery-4c1d70d0ffefbcb7d5458bee9cae8192&#34; class=&#34;gallery&#34;&gt;
  
  
    
    
    
