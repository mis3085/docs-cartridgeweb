        &lt;a class=&#34;group-hover:text-primary-300 dark:group-hover:text-neutral-700 !no-underline&#34; href=&#34;#nachhaltige-druckl%c3%b6sungen-mit-recycelten-tonerkartuschen&#34; aria-label=&#34;Anker&#34;&gt;#&lt;/a&gt;
