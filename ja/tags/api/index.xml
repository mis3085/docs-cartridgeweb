    &lt;span
        class=&#34;absolute top-0 w-6 transition-opacity opacity-0 ltr:-left-6 rtl:-right-6 not-prose group-hover:opacity-100&#34;&gt;
        &lt;a class=&#34;group-hover:text-primary-300 dark:group-hover:text-neutral-700 !no-underline&#34; href=&#34;#%e7%b5%b1%e5%90%88%e3%82%b5%e3%83%bc%e3%83%93%e3%82%b9%e3%81%ab%e3%82%88%e3%82%8b%e3%82%a6%e3%82%a7%e3%83%96%e3%82%b5%e3%82%a4%e3%83%88%e6%a9%9f%e8%83%bd%e3%81%ae%e5%bc%b7%e5%8c%96&#34; aria-label=&#34;アンカー&#34;&gt;#&lt;/a&gt;
