        &lt;a class=&#34;group-hover:text-primary-300 dark:group-hover:text-neutral-700 !no-underline&#34; href=&#34;#%e3%82%b3%e3%83%8b%e3%82%ab%e3%83%9f%e3%83%8e%e3%83%ab%e3%82%bf%e5%af%be%e5%bf%9c%e3%83%88%e3%83%8a%e3%83%bc%e3%82%ab%e3%83%bc%e3%83%88%e3%83%aa%e3%83%83%e3%82%b8%e5%8d%b0%e5%88%b7%e3%83%8b%e3%83%bc%e3%82%ba%e3%81%ab%e5%bf%9c%e3%81%88%e3%82%8b%e5%93%81%e8%b3%aa%e3%81%a8%e4%ba%92%e6%8f%9b%e6%80%a7&#34; aria-label=&#34;アンカー&#34;&gt;#&lt;/a&gt;
    &lt;/span&gt;        
    
