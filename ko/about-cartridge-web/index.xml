        &lt;a class=&#34;group-hover:text-primary-300 dark:group-hover:text-neutral-700 !no-underline&#34; href=&#34;#%ed%86%a0%eb%84%88-%ec%b9%b4%ed%8a%b8%eb%a6%ac%ec%a7%80-%ed%92%88%ec%a7%88%ec%97%90-%eb%8c%80%ed%95%9c-%ed%83%81%ec%9b%94%ed%95%a8%ec%9d%98-%ec%95%bd%ec%86%8d&#34; aria-label=&#34;앵커&#34;&gt;#&lt;/a&gt;
