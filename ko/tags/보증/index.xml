        &lt;a class=&#34;group-hover:text-primary-300 dark:group-hover:text-neutral-700 !no-underline&#34; href=&#34;#%eb%a6%ac%ec%bd%94-%ed%98%b8%ed%99%98-%ed%86%a0%eb%84%88-%ec%b9%b4%ed%8a%b8%eb%a6%ac%ec%a7%80%eb%a1%9c-%ec%8b%a0%eb%a2%b0%ed%95%a0-%ec%88%98-%ec%9e%88%eb%8a%94-%ec%9d%b8%ec%87%84&#34; aria-label=&#34;앵커&#34;&gt;#&lt;/a&gt;
