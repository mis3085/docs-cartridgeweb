        &lt;a class=&#34;group-hover:text-primary-300 dark:group-hover:text-neutral-700 !no-underline&#34; href=&#34;#%d0%bf%d1%80%d0%b8%d0%b2%d0%b5%d1%80%d0%b6%d0%b5%d0%bd%d0%bd%d0%be%d1%81%d1%82%d1%8c-%d1%81%d0%be%d0%b2%d0%b5%d1%80%d1%88%d0%b5%d0%bd%d1%81%d1%82%d0%b2%d1%83-%d0%b2-%d0%ba%d0%b0%d1%87%d0%b5%d1%81%d1%82%d0%b2%d0%b5-%d1%82%d0%be%d0%bd%d0%b5%d1%80-%d0%ba%d0%b0%d1%80%d1%82%d1%80%d0%b8%d0%b4%d0%b6%d0%b5%d0%b9&#34; aria-label=&#34;Якорь&#34;&gt;#&lt;/a&gt;
    &lt;/span&gt;        
    
&lt;/h2&gt;
&lt;div id=&#34;gallery-d7afb9b3f323e46aa89098eb4eaf9770&#34; class=&#34;gallery&#34;&gt;
  
  
    
    
&lt;figure class=&#34;grid-w50 pb-4 text-center&#34;&gt;&lt;img src=&#34;https://mis3085.github.io/docs-cartridgeweb/quality-photo1_7026034113540530986.jpg&#34; alt=&#34;Обеспечение качества в производстве&#34; class=&#34;mx-auto max-w-full h-auto&#34;/&gt;&lt;figcaption&gt;Обеспечение качества в производстве&lt;/figcaption&gt;&lt;/figure&gt;
